# Copy to .env for docker-compose (NEVER commit .env)
SA_PASSWORD=Your_Strong_Password_123!
JWT_SECRET=at-least-32-characters-SuperSecret-unique-please
SEED_ADMIN_PASSWORD=Admin@12345

# ================= AI (OpenRouter / OpenAI-compatible) =================
# App chat-completions endpoint use karta hai (OpenRouter, OpenAI, Azure OpenAI).
# Real keys YAHAN NAHI likhni — sirf placeholder:
#
#   LOCAL DEV  →  dotnet user-secrets set (recommended, kyunki .env dotnet run se nahi padhta):
#       dotnet user-secrets set "Ai__ApiKey" "sk-or-v1-your-key"
#       dotnet user-secrets set "Ai__BaseUrl" "https://openrouter.ai/api/v1"
#       dotnet user-secrets set "Ai__Model" "minimax/minimax-m3:free"
#
#   DOCKER COMPOSE  →  in variables ko .env mein daalo (uppercase):
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=minimax/minimax-m3:free
#
# Cohere alternative (optional):
#   COHERE_API_KEY=
#   COHERE_MODEL=command-r-plus
#
# Koi key na ho → rule-based fallback chalta hai (offline classification).